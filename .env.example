# Copie para .env (cp .env.example .env) antes de rodar docker compose up --build.
# O .env fica fora do git. Os valores abaixo servem só para desenvolvimento local: troque todos
# antes de expor o sistema fora da sua máquina.

# Senha do PostgreSQL. Só vale na criação do volume; para trocar depois: docker compose down -v
DB_PASSWORD=mutua

# Segredo de assinatura do JWT (mínimo de 32 caracteres). Gere um próprio com: openssl rand -hex 32
JWT_SECRET=dev-local-apenas-gere-o-seu-com-openssl-rand-hex-32

# Administrador inicial, criado só na primeira subida (quando ainda não existe nenhum admin).
ADMIN_EMAIL=admin@mutua-pi.com.br
ADMIN_SENHA=admin123

# Endereços do front autorizados no CORS, separados por vírgula.
CORS_ORIGENS=http://localhost:5173,http://localhost:3000
