# Endereço da API do back-end (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1

# Modo de demonstração sem back-end: com "true" os serviços usam dados locais quando a API falha.
# Deixe "false" ao testar a integração, para os erros reais (ex.: conflito de horário) aparecerem.
VITE_USE_MOCK=false
